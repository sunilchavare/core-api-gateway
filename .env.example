# PostgreSQL
POSTGRES_PASSWORD=replace_with_url_safe_password

# JWT authentication — generate with: openssl rand -hex 32
SECRET_KEY=replace_with_generated_secret

# Optional application settings
DOWNSTREAM_TIMEOUT=10

# Only needed to run the integration tests from your own machine (see README, "Run Tests").
# DATABASE_URL=postgresql+psycopg://coreapi:YOUR_POSTGRES_PASSWORD@localhost:5432/core_api_gateway
# REDIS_HOST=localhost
